{
  "name": "pix2text-mfr-web",
  "version": "0.1.2",
  "description": "Client-side Pix2Text MFR-1.5 formula recognition with ONNX Runtime Web",
  "keywords": [
    "ocr",
    "math",
    "latex",
    "formula-recognition",
    "onnx",
    "onnxruntime-web",
    "browser",
    "webgpu"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mapaor/pix2text-mfr-web.git"
  },
  "homepage": "https://github.com/Mapaor/pix2text-mfr-web",
  "bugs": {
    "url": "https://github.com/Mapaor/pix2text-mfr-web/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "download:model": "./scripts/download-model.sh",
    "build": "tsc",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.2",
    "onnxruntime-web": "^1.21.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
